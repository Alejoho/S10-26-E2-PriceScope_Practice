
. "$HOME/.local/bin/env"
# For system-wide Flatpaks
#export PATH="/var/lib/flatpak/exports/bin:$PATH"

# For user-installed Flatpaks
export PATH="$HOME/.local/share/flatpak/exports/bin:$PATH"
# opencode
export PATH=/home/stuart/.opencode/bin:$PATH
autoload -Uz vcs_info add-zsh-hook
zmodload zsh/datetime
setopt prompt_subst

zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' (%b)'
zstyle ':vcs_info:git:*' actionformats ' (%b|%a)'

typeset -g _cmd_start _cmd_elapsed

_timer_start() { _cmd_start=$EPOCHREALTIME }

_timer_stop() {
  if [[ -n $_cmd_start ]]; then
    local d=$(( EPOCHREALTIME - _cmd_start ))
    local ms=$(( d * 1000 ))
    ms=${ms%.*}                      # quita decimales
    if (( ms < 1000 )); then
      _cmd_elapsed="${ms}ms"
    elif (( ms < 60000 )); then
      printf -v _cmd_elapsed '%.2fs' $d
    else
      local s=${${d%.*}}
      _cmd_elapsed="$(( s / 60 ))m$(( s % 60 ))s"
    fi
    _cmd_start=
  else
    _cmd_elapsed=
  fi
}

add-zsh-hook preexec _timer_start
add-zsh-hook precmd  _timer_stop
add-zsh-hook precmd  vcs_info

PROMPT='%~${vcs_info_msg_0_} $ > '
RPROMPT='${_cmd_elapsed:+> $_cmd_elapsed}'

alias ls='ls -l --color=auto'

. "$HOME/.cargo/env"

export PATH="$HOME/.local/share/lua-language-server/bin:$PATH"
export PATH="$HOME/.local/share/jdtls/bin:$PATH"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# pnpm
export PNPM_HOME='/home/stuart/.local/share/pnpm'
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Where to save the history file
HISTFILE=~/.zsh_history

# Number of commands to maintain in the session memory
HISTSIZE=10000

# Number of commands to save in the actual history file
SAVEHIST=10000

# Instantly append commands to the history file instead of waiting for exit
setopt INC_APPEND_HISTORY

# Share history across all open terminal windows/tabs
setopt SHARE_HISTORY
